#!/bin/sh
# AEP project check — edit this to run YOUR real build+test command.
# Exit 0 = green (task may complete). Non-zero = red (completion blocked).
# Keep it fast: prefer affected tests over the full suite where possible.
#
# Examples:
#   dotnet build --nologo -clp:ErrorsOnly && dotnet test --nologo
#   npm run lint && npm test -- --run
#   pytest -q && ruff check .
#   go vet ./... && go test ./...

# Replace this stub with your real command. Until you do, the gate is green and
# proves nothing - a check that cannot fail is not a check.
echo "AEP check stub: no project check configured yet (always green)."

# Requirements traceability: fails when a `done` row's proof has left the tree,
# when a deferral has no date and reason, or when a `cmd:` proof stops exiting 0.
# Delete these two lines if this project does not keep a requirements ledger.
[ -f .claude/trace.py ] && { python3 .claude/trace.py || exit 1; }

exit 0
